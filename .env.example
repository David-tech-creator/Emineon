# emineon.com environment variables. Copy to .env.local for local development and set the same
# names in Vercel (Project → Settings → Environment Variables, Production and Preview).
# Never commit real values. See SETUP-EMAIL.md for the email setup, step by step.
#
# With RESEND_API_KEY empty the site runs in DRY MODE: the contact form and the newsletter accept
# submissions, log what they would send (Vercel logs / terminal) and send nothing.

# --- Site ---
# Canonical origin used in metadata, sitemap, RSS and every link inside emails.
NEXT_PUBLIC_SITE_URL=https://www.emineon.com

# --- Resend ---
# API key with "Sending access" (and "Full access" if you want the site to add contacts; see SETUP-EMAIL.md).
RESEND_API_KEY=

# --- Contact form (POST /api/contact) ---
# Where notifications go: David's mailbox. Not shown anywhere on the site.
CONTACT_TO=david.v@emineon.com
# Sender of the notification (must be on the verified emineon.com domain).
CONTACT_FROM=Emineon website <notifications@emineon.com>
# Short localised "we have your message" email to the sender. Set to false to turn it off.
CONTACT_CONFIRMATION=true
# Sender and reply-to of that receipt.
CONTACT_CONFIRMATION_FROM=Emineon <hello@emineon.com>
CONTACT_REPLY_TO=hello@emineon.com

# --- Newsletter (POST /api/newsletter, GET /api/newsletter/confirm) ---
NEWSLETTER_FROM=Emineon <hello@emineon.com>
NEWSLETTER_REPLY_TO=hello@emineon.com
# Signs the double opt-in confirmation links. Required once RESEND_API_KEY is set.
# Generate one with: openssl rand -base64 32
NEWSLETTER_SECRET=
# Resend segment confirmed readers are added to (Audience → Segments → id).
NEWSLETTER_SEGMENT_ID=
# Optional per-language segments. Without them FR and DE readers join NEWSLETTER_SEGMENT_ID.
NEWSLETTER_SEGMENT_ID_FR=
NEWSLETTER_SEGMENT_ID_DE=

# --- Local only ---
# In dry mode, also write every email as an HTML file to this folder, to preview it in a browser.
# EMAIL_DRY_DIR=/tmp/emineon-emails
